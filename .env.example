# Ollama 配置
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Document Worker 配置
DOC_MODEL=qwen3:4b
OLLAMA_NUM_PREDICT=8192      # 单次生成最大 token
CHUNK_CHARS=3000             # 长文档分块字符数
CHUNK_OVERLAP=500            # 分块重叠字符数
MAX_FILE_BYTES=5242880       # 单文件大小上限（5MB）
TEMP_EXTRACT=0.2             # 提取任务温度
TEMP_GENERATE=0.4            # 生成类任务温度
MAX_RETRIES=2                # Ollama 调用失败重试次数

# 图像配置
MAX_IMAGE_SIZE=20971520  # 20MB

# 详细图像分析（analyze_image_detailed）分区参数
VISION_DIRECT_AREA=2000000   # 面积不超过该值时单次直读，不分区
VISION_TILE_AREA=1200000     # 每块面积预算（像素）
VISION_MAX_TILES=12          # 分块数量上限
VISION_OVERLAP=0.12          # 网格切分重叠比例
VISION_ROI_GUIDED=0          # 1=启用两级模型引导定位（实验性，密集图可能不理想）

# 日志配置
LOG_LEVEL=INFO

# 模型生命周期（是否卸载由 MCP 工具参数 unload_after_task 控制，默认 True；
# 这里仅配置卸载请求本身的 HTTP 超时）
UNLOAD_REQUEST_TIMEOUT=10
